# 所有的一般可执行文件
/**/*.exe

# Keil IDE编辑器忽略项
/**/MDK-ARM/*
# 不忽略keil工程配置文件
!/**/MDK-ARM/*.uvoptx
!/**/MDK-ARM/*.uvprojx
!/**/MDK-ARM/startup_*.s

# armgcc-cmake工程忽略项
/**/cmake-build-debug

# VsCode编辑器忽略项
/**/.vscode
/**/workspace.code-workspace

# clion编辑器忽略项
/**/.idea

# 忽略 CMake 编译生成的各种中间文件与目录
build/
bin/
*.o
*.a
*.so

# 忽略日志文件
*.log